# Supabase project settings — find these in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Never put the service_role key in a NEXT_PUBLIC_ variable or in any client-side code.
# It is not needed by this app — RLS policies protect data instead.
